@model List<DriveNow.MVC.Models.AgenciaView>

@{
    ViewData["Title"] = "Agências";
}

<h2>Agências</h2>

<p>
    <a asp-action="CriarAgencia" class="primary btn btn-primary">Nova Agência</a>
</p>

<table class="table table-bordered table-hover">
    <thead>
        <tr>
            <th>Nome Fantasia</th>
            <th>CEP</th>
            <th>Cidade</th>
            <th>UF</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var agencia in Model)
        {
            <tr>
                <td>@agencia.NomeFantasia</td>
                <td>@agencia.Cep</td>
                <td>@agencia.Localidade</td>
                <td>@agencia.Uf</td>
                <td>
                    <a asp-action="EditarAgencia" asp-route-id="@agencia.Id" class="btn btn-warning btn-sm">Editar</a>
                    <a asp-action="DeletarAgencia" asp-route-id="@agencia.Id" class="btn btn-danger btn-sm">Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>